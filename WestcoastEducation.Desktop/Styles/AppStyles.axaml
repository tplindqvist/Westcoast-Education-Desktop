<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="950" />
        <Setter Property="Height" Value="600" />
    </Style>

    <Style Selector="Border.titleBar">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style Selector="Border.titleBar>TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="UserControl.content">
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- rubrikraden i listor -->
    <Style Selector="Border.listHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource ShadowBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="Border.listHeader TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- laddningsstapel -->
    <Style Selector="ProgressBar.loading">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="20,0,20,10" />
    </Style>

    <!-- varje rad i listor -->
    <Style Selector="Grid.listRow">
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="Grid.listRow > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Rad med textruta + knapp i formulär -->
    <Style Selector="Grid.inputRow">
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Grid.inputRow > Button">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Listrader -->
    <Style Selector="Grid.listRow > Button">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Spara-knappen i formulär -->
    <Style Selector="Button.save">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Dialogrutan (Ja/Nej eller OK) -->
    <Style Selector="Window.dialog">
        <Setter Property="Width" Value="340" />
        <Setter Property="Height" Value="110" />
    </Style>

    <Style Selector="StackPanel.dialog">
        <Setter Property="Margin" Value="16" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style Selector="StackPanel.dialog > TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Knapparna till höger, jämte varandra -->
    <Style Selector="StackPanel.dialogButtons">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="StackPanel.dialogButtons > Button">
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</Styles>