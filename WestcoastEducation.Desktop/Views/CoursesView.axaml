<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestcoastEducation.Desktop.ViewModels"
             x:DataType="vm:CoursesViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestcoastEducation.Desktop.Views.CoursesView">
    <StackPanel>
        <TextBlock Text="Kurser" />

        <!-- Rubrik -->
        <Grid ColumnDefinitions="100,250,80,120,120,100,Auto">
            <TextBlock Grid.Column="0" Text="Kursnr" />
            <TextBlock Grid.Column="1" Text="Titel" />
            <TextBlock Grid.Column="2" Text="Veckor" />
            <TextBlock Grid.Column="3" Text="Start" />
            <TextBlock Grid.Column="4" Text="Slut" />
            <TextBlock Grid.Column="5" Text="Typ" />
        </Grid>

        <!-- En rad per kurs -->
        <ItemsControl ItemsSource="{Binding Courses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="100,250,80,120,120,100,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding CourseNumber}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Text="{Binding LengthInWeeks}" />
                        <TextBlock Grid.Column="3" Text="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" />
                        <TextBlock Grid.Column="4" Text="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}" />
                        <TextBlock Grid.Column="5" Text="{Binding CourseTypeText}" />
                        <Button Grid.Column="6" Content="Radera"
                                Command="{Binding $parent[UserControl].((vm:CoursesViewModel)DataContext).DeleteCourseCommand}"
                                CommandParameter="{Binding Id}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>