<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

             x:Class="WestcoastEducation.Desktop.Views.HomeView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="titleBar">
            <TextBlock Text="Hem" />
        </Border>

        <StackPanel Grid.Row="1" Classes="home">
            <TextBlock Classes="heading" Text="Välkommen till Westcoast Education" />
            <TextBlock Text="Administration av kurser, studenter och lärare" />
            
            <TextBlock Text="Kom igång genom att välja något i menyn ovan." />

            <Border Classes="tipBox">
                <StackPanel>
                    <TextBlock Classes="tipTitle" Text="Visste du att...?" />
                    <TextBlock Text="Du kan ändra en lärares kompetensområden genom att klicka på ändra i lärarlistan." />
                </StackPanel>
            </Border>

        </StackPanel>
            <TextBlock Grid.Row="2" Classes="footer" Text="Version 1.0" />

    </Grid>
</UserControl>