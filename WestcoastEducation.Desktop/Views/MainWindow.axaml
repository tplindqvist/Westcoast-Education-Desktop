<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestcoastEducation.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestcoastEducation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Westcoast Education">

    <Grid RowDefinitions="Auto,*,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="Arkiv">
                <MenuItem Header="Hem" Command="{Binding GoToHomeCommand}" />
            </MenuItem>
            
            <MenuItem Header="Kurser">
                <MenuItem Header="Lista kurser" Command="{Binding GoToCoursesCommand}" />
                <MenuItem Header="Lägg till kurs" Command="{Binding GoToAddCourseCommand}" />
            </MenuItem>
            
            <MenuItem Header="Studenter">
                <MenuItem Header="Lista studenter" Command="{Binding GoToStudentsCommand}" />
                <MenuItem Header="Lägg till student" Command="{Binding GoToAddStudentCommand}" />
            </MenuItem>
            
            <MenuItem Header="Lärare">
                <MenuItem Header="Lista lärare" Command="{Binding GoToTeachersCommand}" />
                <MenuItem Header="Lägg till lärare" Command="{Binding GoToAddTeacherCommand}" />
            </MenuItem>
            
        </Menu>


        <UserControl Grid.Row="1" Classes="content" Content="{Binding CurrentView}" />

        <ProgressBar Grid.Row="2" Classes="loading" IsIndeterminate="True"
                     IsVisible="{Binding CurrentView.IsLoading}" />

    </Grid>

</Window>