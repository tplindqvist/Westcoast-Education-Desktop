<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WestcoastEducation.Desktop.App"
             xmlns:local="using:WestcoastEducation.Desktop"
             RequestedThemeVariant="Light">
             

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    
    <!-- färgerna -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/AppStyles.axaml" /> <!-- stilarna -->
    </Application.Styles>
</Application>